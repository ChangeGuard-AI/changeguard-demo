# ChangeGuard > Settings > API Keys > create a key with CI/CD scope
CHANGEGUARD_API_KEY=

# The cluster's name in ChangeGuard > Environments
CHANGEGUARD_ENVIRONMENT=

# Optional: kubectl context for that cluster (default: kubectl's current context)
KUBE_CONTEXT=

# Optional, instead of CHANGEGUARD_API_KEY: read the key from AWS Secrets Manager at run time
# CHANGEGUARD_API_KEY_AWS_SECRET=
# AWS_REGION=
